{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://word-tree.local/schema/review-artifact.schema.json",
  "title": "Word Tree independent review artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "packetId",
    "draftId",
    "revision",
    "scope",
    "reviewerRole",
    "reviewerId",
    "independent",
    "status",
    "issues",
    "reviewedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reviewId": { "type": "string", "minLength": 1 },
    "packetId": { "type": "string", "minLength": 1 },
    "draftId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "scope": { "$ref": "#/$defs/scope" },
    "reviewerRole": {
      "enum": [
        "source",
        "morphology",
        "grammar",
        "meaning",
        "pedagogy",
        "schema",
        "adjudicator"
      ]
    },
    "reviewerId": { "type": "string", "minLength": 1 },
    "independent": { "type": "boolean" },
    "status": { "enum": ["approved", "revision-required"] },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "reviewedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ayahIds"],
      "properties": {
        "type": { "enum": ["packet", "ayah"] },
        "ayahIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "severity",
        "scopeId",
        "path",
        "message",
        "requiredAction",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error", "blocker"] },
        "scopeId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "requiredAction": { "type": "string", "minLength": 1 },
        "evidence": { "type": "object" }
      }
    }
  }
}
