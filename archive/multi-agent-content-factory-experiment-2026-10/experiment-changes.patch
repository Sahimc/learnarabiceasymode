index 0000000..28d6b5c
--- /dev/null
+++ b/content-import/schema/source-packet.schema.json
@@ -0,0 +1,110 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://word-tree.local/schema/source-packet.schema.json",
+  "title": "Word Tree source packet",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "packetId",
+    "sourcePackageId",
+    "sourceFingerprint",
+    "knowledgeSnapshot",
+    "status",
+    "surahNumber",
+    "ayahStart",
+    "ayahEnd",
+    "sourceVersion",
+    "sourceReferences",
+    "ayahs"
+  ],
+  "properties": {
+    "schemaVersion": { "const": "1.0.0" },
+    "packetId": { "type": "string", "minLength": 1 },
+    "sourcePackageId": { "type": "string", "minLength": 1 },
+    "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
+    "knowledgeSnapshot": { "$ref": "#/$defs/knowledgeSnapshot" },
+    "status": { "const": "source-imported" },
+    "surahNumber": { "type": "integer", "minimum": 1, "maximum": 114 },
+    "ayahStart": { "type": "integer", "minimum": 1 },
+    "ayahEnd": { "type": "integer", "minimum": 1 },
+    "sourceVersion": { "type": "string", "minLength": 1 },
+    "sourceReferences": {
+      "type": "array",
+      "items": { "$ref": "#/$defs/sourceReference" }
+    },
+    "ayahs": {
+      "type": "array",
+      "minItems": 1,
+      "items": { "$ref": "#/$defs/ayah" }
+    }
+  },
+  "$defs": {
+    "knowledgeSnapshot": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["snapshotId", "version", "files"],
+      "properties": {
+        "snapshotId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
+        "version": { "type": "string", "minLength": 1 },
+        "files": {
+          "type": "array",
+          "minItems": 1,
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": ["path", "checksum"],
+            "properties": {
+              "path": { "type": "string", "minLength": 1 },
+              "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
+            }
+          }
+        }
+      }
+    },
+    "sourceReference": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["provider", "recordKey"],
+      "properties": {
+        "provider": { "type": "string", "minLength": 1 },
+        "recordKey": { "type": "string", "minLength": 1 },
+        "version": { "type": "string" },
+        "attribution": { "type": "string" }
+      }
+    },
+    "word": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["id", "position", "arabic", "sourceReferences"],
+      "properties": {
+        "id": { "type": "string", "minLength": 1 },
+        "position": { "type": "integer", "minimum": 1 },
+        "arabic": { "type": "string", "minLength": 1 },
+        "transliteration": { "type": "string" },
+        "gloss": { "type": "string" },
+        "sourceReferences": {
+          "type": "array",
+          "items": { "$ref": "#/$defs/sourceReference" }
+        }
+      }
+    },
+    "ayah": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["id", "number", "arabic", "words"],
+      "properties": {
+        "id": { "type": "string", "minLength": 1 },
+        "number": { "type": "integer", "minimum": 1 },
+        "arabic": { "type": "string", "minLength": 1 },
+        "sourceRawArabic": { "type": "string" },
+        "translation": { "type": "string" },
+        "words": {
+          "type": "array",
+          "minItems": 1,
+          "items": { "$ref": "#/$defs/word" }
+        }
+      }
+    }
+  }
+}
