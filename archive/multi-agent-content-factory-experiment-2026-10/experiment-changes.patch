+{
+  "schemaVersion": "1.0.0",
+  "provider": "quranic-arabic-corpus",
+  "purpose": "Versioned source-morphology reconstruction overrides. These are provider/import evidence and are not project-authored teaching prose.",
+  "surfaceByOccurrence": {
+    "113:1:2": ["أَ", "عُوذُ"],
+    "114:1:2": ["أَ", "عُوذُ"],
+    "113:1:3": ["بِ", "رَبِّ"],
+    "114:1:3": ["بِ", "رَبِّ"],
+    "114:6:3": ["وَ", "ٱلنَّاسِ"],
+    "113:4:3": ["ٱل", "نَّفَّاثَاتِ"]
+  },
+  "surfaceByArabic": {
+    "ٱلنَّاسِ": ["ٱل", "نَّاسِ"]
+  },
+  "formationByOccurrence": {
+    "113:4:3": [
+      {
+        "displayText": "نَفَّاثَة",
+        "label": "lemma / singular",
+        "meaning": "female blower",
+        "kind": "lemma"
+      },
+      {
+        "displayText": "ـاتِ",
+        "label": "ending",
+        "meaning": "feminine plural with a genitive ending here",
+        "kind": "ending"
+      }
+    ]
+  }
+}
