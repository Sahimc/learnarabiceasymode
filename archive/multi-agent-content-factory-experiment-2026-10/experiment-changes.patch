diff --git a/content-authoring/production-knowledge/safeguards/common-problems.json b/content-authoring/production-knowledge/safeguards/common-problems.json
new file mode 100644
index 0000000..5905336
--- /dev/null
+++ b/content-authoring/production-knowledge/safeguards/common-problems.json
@@ -0,0 +1,30 @@
+{
+  "schemaVersion": "1.0.0",
+  "entries": [
+    {
+      "id": "breakdown-display-versus-source",
+      "problem": "A joining line or visual decoration changes the stored Arabic component.",
+      "safeguard": "Keep canonical sourceText separate from displayText and reconstruct only from sourceText."
+    },
+    {
+      "id": "incomplete-segmentation",
+      "problem": "Only a prefix or partial component is shown for a complete word.",
+      "safeguard": "Validate that ordered parts reconstruct the complete visible occurrence; use truthful atomic mode when a reviewed split is unavailable."
+    },
+    {
+      "id": "repeated-word-context",
+      "problem": "A repeated word inherits an unrelated occurrence explanation.",
+      "safeguard": "Reuse shared lexical data only where appropriate and retain occurrence-specific grammar, meaning and overrides."
+    },
+    {
+      "id": "placeholder-teaching",
+      "problem": "Labels such as Whole word or Main word are mistaken for reviewed analysis.",
+      "safeguard": "Reject placeholder labels for custom-complete content and block publication until reviewed data exists."
+    },
+    {
+      "id": "parallel-file-conflict",
+      "problem": "Multiple workers edit the same sūrah package or canonical database rows.",
+      "safeguard": "Workers write unique immutable packet revisions; one deterministic assembler and serialized importer own canonical writes."
+    }
+  ]
+}
diff --git a/content-authoring/production-knowledge/safeguards/reviewer-rules.json b/content-authoring/production-knowledge/safeguards/reviewer-rules.json
new file mode 100644
index 0000000..851000d
--- /dev/null
+++ b/content-authoring/production-knowledge/safeguards/reviewer-rules.json
@@ -0,0 +1,17 @@
+{
+  "schemaVersion": "1.0.0",
+  "rules": [
+    {
+      "id": "review-independently",
+      "rule": "Independent reviewers must form their conclusions before seeing another reviewer’s opinion."
+    },
+    {
+      "id": "provider-is-evidence",
+      "rule": "Provider morphology is evidence and must not be presented as project-authored teaching without review."
+    },
+    {
+      "id": "source-only-is-honest",
+      "rule": "Source-only occurrences may omit custom teaching and must never receive invented roots, explanations or breakdowns."
+    }
+  ]
+}
diff --git a/content-authoring/production-knowledge/safeguards/source-policy.json b/content-authoring/production-knowledge/safeguards/source-policy.json
new file mode 100644
index 0000000..5eaffff
--- /dev/null
+++ b/content-authoring/production-knowledge/safeguards/source-policy.json
@@ -0,0 +1,17 @@
+{
+  "schemaVersion": "1.0.0",
+  "rules": [
+    {
+      "id": "canonical-source-preserved",
+      "rule": "Canonical Arabic sourceText is preserved exactly; display-only joining marks never enter source reconstruction."
+    },
+    {
+      "id": "stable-occurrence-identity",
+      "rule": "A word occurrence is identified by its stable surah, ayah and position identity."
+    },
+    {
+      "id": "no-runtime-fallback-promotion",
+      "rule": "A runtime or provider fallback cannot be promoted to completed custom teaching."
+    }
+  ]
+}
