+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://word-tree.local/schema/content-draft.schema.json",
+  "title": "Word Tree structured content-data draft",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "draftId",
+    "packetId",
+    "sourceFingerprint",
+    "knowledgeSnapshot",
+    "revision",
+    "status",
+    "createdBy",
+    "ayahs"
+  ],
+  "properties": {
+    "schemaVersion": { "const": "1.0.0" },
+    "draftId": { "type": "string", "minLength": 1 },
+    "packetId": { "type": "string", "minLength": 1 },
+    "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
+    "knowledgeSnapshot": { "$ref": "#/$defs/knowledgeSnapshot" },
+    "revision": { "type": "integer", "minimum": 1 },
+    "status": {
+      "enum": [
+        "source-imported",
+        "draft",
+        "review-required",
+        "repair-required",
+        "approved",
+        "assembled",
+        "imported"
+      ]
+    },
+    "createdBy": { "type": "string", "minLength": 1 },
+    "ayahs": {
+      "type": "array",
+      "minItems": 1,
+      "items": { "$ref": "#/$defs/ayah" }
+    }
+  },
+  "$defs": {
+    "knowledgeSnapshot": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["snapshotId", "version", "files"],
+      "properties": {
+        "snapshotId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
+        "version": { "type": "string", "minLength": 1 },
+        "files": {
+          "type": "array",
+          "minItems": 1,
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": ["path", "checksum"],
+            "properties": {
+              "path": { "type": "string", "minLength": 1 },
+              "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
+            }
+          }
+        }
+      }
+    },
+    "layerStatus": {
+      "enum": ["pending", "draft", "reviewed", "approved", "not-applicable"]
+    },
+    "layerState": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "segmentation",
+        "morphology",
+        "grammar",
+        "meaning",
+        "learnerConnections",
+        "pedagogy"
+      ],
+      "properties": {
+        "segmentation": { "$ref": "#/$defs/layerStatus" },
+        "morphology": { "$ref": "#/$defs/layerStatus" },
+        "grammar": { "$ref": "#/$defs/layerStatus" },
+        "meaning": { "$ref": "#/$defs/layerStatus" },
+        "learnerConnections": { "$ref": "#/$defs/layerStatus" },
+        "pedagogy": { "$ref": "#/$defs/layerStatus" }
+      }
+    },
+    "breakdown": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["id", "mode", "sourceText", "parts"],
+      "properties": {
+        "id": { "type": "string", "minLength": 1 },
+        "mode": { "enum": ["atomic", "segmented"] },
+        "sourceText": { "type": "string", "minLength": 1 },
+        "parts": {
+          "type": "array",
+          "minItems": 1,
+          "items": { "$ref": "#/$defs/part" }
+        }
+      }
+    },
+    "part": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "id",
+        "order",
+        "sourceText",
+        "displayText",
+        "label",
+        "meaning",
+        "kind"
+      ],
+      "properties": {
+        "id": { "type": "string", "minLength": 1 },
+        "order": { "type": "integer", "minimum": 1 },
+        "sourceText": { "type": "string", "minLength": 1 },
+        "displayText": { "type": "string", "minLength": 1 },
+        "label": { "type": "string", "minLength": 1 },
+        "meaning": { "type": "string", "minLength": 1 },
+        "kind": {
+          "enum": [
+            "whole",
+            "prefix",
+            "stem",
+            "suffix",
+            "article",
+            "preposition",
+            "subject-marker",
+            "object-pronoun",
+            "possessive-pronoun",
+            "ending",
+            "connector",
+            "other"
+          ]
+        }
+      }
+    },
+    "word": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["wordId", "layers", "layerState"],
+      "properties": {
+        "wordId": { "type": "string", "minLength": 1 },
+        "teachingId": { "type": "string", "minLength": 1 },
+        "layers": {
+          "type": "object",
+          "additionalProperties": false,
+          "properties": {
+            "surfaceBreakdown": { "$ref": "#/$defs/breakdown" },
+            "breakdownScope": { "enum": ["shared", "occurrence"] },
+            "teaching": { "$ref": "#/$defs/teaching" },
+            "occurrenceRole": { "type": "string", "minLength": 1 },
+            "morphology": {
+              "type": "object",
+              "additionalProperties": false,
+              "properties": {
+                "provider": { "type": "string", "minLength": 1 },
+                "root": { "type": "string" },
+                "lemma": { "type": "string" },
+                "pattern": { "type": "string" },
+                "partOfSpeech": { "type": "string" },
+                "features": {
+                  "type": "array",
+                  "items": { "type": "string", "minLength": 1 }
+                },
+                "notes": { "type": "string" }
+              }
+            },
+            "grammar": { "type": "string", "minLength": 1 },
+            "meaning": { "type": "string", "minLength": 1 },
+            "learnerConnections": {
+              "type": "array",
+              "items": { "type": "string", "minLength": 1 }
+            },
+            "pedagogy": {
+              "type": "object",
+              "additionalProperties": false,
+              "properties": {
+                "recognitionClue": { "type": "string", "minLength": 1 },
+                "explanation": { "type": "string", "minLength": 1 },
+                "takeaway": { "type": "string", "minLength": 1 }
+              }
+            }
+          }
+        },
+        "layerState": { "$ref": "#/$defs/layerState" }
+      }
+    },
+    "ayah": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["ayahId", "ayahLayers", "words"],
+      "properties": {
+        "ayahId": { "type": "string", "minLength": 1 },
+        "ayahLayers": { "type": "object" },
+        "words": {
+          "type": "array",
+          "minItems": 1,
+          "items": { "$ref": "#/$defs/word" }
+        }
+      }
+    },
+    "teaching": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "id",
+        "meaning",
+        "type",
+        "root",
+        "rootPicture",
+        "construction",
+        "grammar",
+        "sentenceRole",
+        "recognitionClue",
+        "forms",
+        "takeaway"
+      ],
+      "properties": {
+        "id": { "type": "string", "minLength": 1 },
+        "meaning": { "type": "string", "minLength": 1 },
+        "type": { "type": "string", "minLength": 1 },
+        "root": { "type": "string" },
+        "rootPicture": { "type": "string" },
+        "construction": { "type": "string", "minLength": 1 },
+        "grammar": { "type": "string", "minLength": 1 },
+        "sentenceRole": { "type": "string", "minLength": 1 },
+        "recognitionClue": { "type": "string", "minLength": 1 },
+        "forms": {
+          "type": "array",
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": ["form", "meaning", "difference"],
+            "properties": {
+              "form": { "type": "string", "minLength": 1 },
+              "meaning": { "type": "string", "minLength": 1 },
+              "difference": { "type": "string", "minLength": 1 }
+            }
+          }
+        },
+        "takeaway": { "type": "string", "minLength": 1 }
+      }
+    }
+  }
+}
