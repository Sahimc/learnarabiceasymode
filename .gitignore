# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
.dev-server*.log
*.tsbuildinfo
/.local/
/test-results/
/playwright-report/

# generated content-audit reports are archived outside the repository
/artifacts/content-review/limited-sarf-audit-*.json

# Compositional gloss full-corpus ledgers are reconciled only at sūrah boundaries.
# Keep the generated full ledgers and timestamped exports out of Git change scans.
/artifacts/compositional-gloss-audit-2026-10/coverage-ledger.jsonl
/artifacts/compositional-gloss-audit-2026-10/coverage-ledger.reconciled.*
/artifacts/compositional-gloss-audit-2026-10/coverage-ledger.rendered.*
/artifacts/compositional-gloss-audit-2026-10/coverage-ledger.searchable.*
/artifacts/compositional-gloss-audit-2026-10/coverage-ledger.20*
/artifacts/compositional-gloss-audit-2026-10/coverage-ledger.full-20*
/artifacts/compositional-gloss-audit-2026-10/coverage-ledger.*.tmp*
/.codex-*.tmp.mjs
