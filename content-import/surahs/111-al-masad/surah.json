  "arabicName": "المسد",
  "transliteration": "Al-Masad",
  "englishLabel": "The Palm Fibre",
  "status": "source-only",
  "ayahs": [
    {
      "id": "ayah:111:1",
      "number": 1,
      "arabic": "تَبَّتْ يَدَا أَبِي لَهَبٍ وَتَبَّ",
      "translation": "May the hands of Abū Lahab perish, and perish he.",
      "words": ["تَبَّتْ", "يَدَا", "أَبِي", "لَهَبٍ", "وَتَبَّ"]
    },
    {
      "id": "ayah:111:2",
      "number": 2,
      "arabic": "مَا أَغْنَىٰ عَنْهُ مَالُهُ وَمَا كَسَبَ",
      "translation": "His wealth and what he earned will not avail him.",
      "words": ["مَا", "أَغْنَىٰ", "عَنْهُ", "مَالُهُ", "وَمَا", "كَسَبَ"]
    },
    {
      "id": "ayah:111:3",
      "number": 3,
      "arabic": "سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ",
      "translation": "He will burn in a flaming fire.",
      "words": ["سَيَصْلَىٰ", "نَارًا", "ذَاتَ", "لَهَبٍ"]
    },
    {
      "id": "ayah:111:4",
      "number": 4,
      "arabic": "وَامْرَأَتُهُ حَمَّالَةَ الْحَطَبِ",
      "translation": "And his wife, the carrier of firewood.",
      "words": ["وَامْرَأَتُهُ", "حَمَّالَةَ", "الْحَطَبِ"]
    },
    {
      "id": "ayah:111:5",
      "number": 5,
      "arabic": "فِي جِيدِهَا حَبْلٌ مِّن مَّسَدٍ",
      "translation": "Around her neck is a rope of palm fibre.",
      "words": ["فِي", "جِيدِهَا", "حَبْلٌ", "مِّن", "مَّسَدٍ"]
    }
  ]
