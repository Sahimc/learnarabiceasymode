{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://word-tree.local/schema/ayah.schema.json",
  "title": "Qur’anic Arabic Word Tree āyah",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "number", "arabic", "words"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "number": { "type": "integer", "minimum": 1 },
    "arabic": { "type": "string", "minLength": 1 },
    "sourceRawArabic": { "type": "string" },
    "translation": { "type": "string" },
    "naturalMeaning": { "type": "string" },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "word.schema.json" }
    }
  }
}
