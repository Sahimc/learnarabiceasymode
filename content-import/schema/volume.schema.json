{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://word-tree.local/schema/volume.schema.json",
  "title": "Qur’anic Arabic Word Tree volume",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "surahNumbers"],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "surahNumbers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1, "maximum": 114 }
    }
  }
}
