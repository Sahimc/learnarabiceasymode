{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://word-tree.local/schema/package.schema.json",
  "title": "Qur’anic Arabic Word Tree content package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "surah",
    "contentVersion",
    "status",
    "sourceReferences",
    "ayahs",
    "teachingEntries"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "packageId": { "type": "string", "minLength": 1 },
    "surah": { "$ref": "surah.schema.json" },
    "contentVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["source-only", "custom-partial", "custom-complete"] },
    "sourceReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/providerReference" }
    },
    "ayahs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "ayah.schema.json" }
    },
    "teachingEntries": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/teachingLesson" }
    },
    "volumeReferences": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "providerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "recordKey"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "recordKey": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "attribution": { "type": "string" }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "sourceText",
        "displayText",
        "label",
        "meaning",
        "kind"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "sourceText": { "type": "string", "minLength": 1 },
        "displayText": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "whole",
            "prefix",
            "stem",
            "suffix",
            "article",
            "preposition",
            "connector",
            "subject-marker",
            "object-pronoun",
            "possessive-pronoun",
            "ending",
            "other"
          ]
        }
      }
    },
    "breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "sourceText", "parts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["atomic", "segmented"] },
        "sourceText": { "type": "string", "minLength": 1 },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/part" }
        }
      }
    },
    "lessonForm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "meaning", "difference"],
      "properties": {
        "form": { "type": "string" },
        "meaning": { "type": "string" },
        "difference": { "type": "string" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "label", "meaning"],
      "properties": {
        "text": { "type": "string" },
        "displayText": { "type": "string" },
        "label": { "type": "string" },
        "meaning": { "type": "string" },
        "kind": { "type": "string" }
      }
    },
    "teachingLesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "meaning",
        "type",
        "root",
        "rootPicture",
        "construction",
        "components",
        "grammar",
        "sentenceRole",
        "recognitionClue",
        "forms",
        "takeaway"
      ],
      "properties": {
        "id": { "type": "string" },
        "meaning": { "type": "string" },
        "type": { "type": "string" },
        "root": { "type": "string" },
        "rootPicture": { "type": "string" },
        "construction": { "type": "string" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        },
        "breakdown": { "$ref": "#/$defs/breakdown" },
        "grammar": { "type": "string" },
        "sentenceRole": { "type": "string" },
        "recognitionClue": { "type": "string" },
        "forms": { "type": "array", "items": { "$ref": "#/$defs/lessonForm" } },
        "takeaway": { "type": "string" }
      }
    }
  }
}
