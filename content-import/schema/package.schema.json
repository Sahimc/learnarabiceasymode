{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://word-tree.local/schema/package.schema.json",
  "title": "Qur’anic Arabic Word Tree content package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "surah",
    "contentVersion",
    "status",
    "sourceReferences",
    "ayahs",
    "teachingEntries"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "packageId": { "type": "string", "minLength": 1 },
    "surah": { "$ref": "surah.schema.json" },
    "contentVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["source-only", "custom-partial", "custom-complete"] },
    "sourceReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/providerReference" }
    },
    "ayahs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "ayah.schema.json" }
    },
    "teachingEntries": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/teachingLesson" }
    },
    "volumeReferences": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "providerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "recordKey"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "recordKey": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "attribution": { "type": "string" }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "sourceText",
        "displayText",
        "label",
        "meaning",
        "kind"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "sourceText": { "type": "string", "minLength": 1 },
        "displayText": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "whole",
            "prefix",
            "stem",
            "suffix",
            "article",
            "preposition",
            "connector",
            "subject-marker",
            "object-pronoun",
            "possessive-pronoun",
            "ending",
            "other"
          ]
        }
      }
    },
    "breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "sourceText", "parts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["atomic", "segmented"] },
        "sourceText": { "type": "string", "minLength": 1 },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/part" }
        }
      }
    },
    "lessonForm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form",
        "meaning",
        "difference",
        "relationship",
        "provenance"
      ],
      "properties": {
        "form": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "difference": { "type": "string", "minLength": 1 },
        "relationship": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 }
      }
    },
    "sarfReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provenance", "reviewedBy", "reviewedAt"],
      "properties": {
        "status": { "enum": ["full", "limited"] },
        "limitedReason": { "type": "string", "minLength": 1 },
        "auditDecision": {
          "enum": [
            "confirmed-limited",
            "upgraded-to-full",
            "blocked-for-genuine-ambiguity"
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reviewedBy": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "limited" } } },
          "then": {
            "required": ["limitedReason", "auditDecision"],
            "properties": {
              "auditDecision": {
                "enum": [
                  "confirmed-limited",
                  "blocked-for-genuine-ambiguity"
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "full" } } },
          "then": { "not": { "required": ["limitedReason"] } }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "label", "meaning"],
      "properties": {
        "text": { "type": "string" },
        "displayText": { "type": "string" },
        "label": { "type": "string" },
        "meaning": { "type": "string" },
        "kind": { "type": "string" }
      }
    },
    "rootReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "providerRoot", "reviewedRoot", "rationale", "provenance"],
      "properties": {
        "status": { "const": "reviewed-override" },
        "providerRoot": { "type": "string", "minLength": 1 },
        "reviewedRoot": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "teachingLesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "meaning",
        "type",
        "root",
        "rootPicture",
        "construction",
        "components",
        "grammar",
        "sentenceRole",
        "recognitionClue",
        "forms",
        "sarfReview",
        "takeaway"
      ],
      "properties": {
        "id": { "type": "string" },
        "meaning": { "type": "string" },
        "type": { "type": "string" },
        "root": { "type": "string" },
        "rootPicture": { "type": "string" },
        "rootReview": { "$ref": "#/$defs/rootReview" },
        "construction": { "type": "string" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        },
        "breakdown": { "$ref": "#/$defs/breakdown" },
        "grammar": { "type": "string" },
        "sentenceRole": { "type": "string" },
        "recognitionClue": { "type": "string" },
        "forms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lessonForm" }
        },
        "sarfReview": { "$ref": "#/$defs/sarfReview" },
        "takeaway": { "type": "string" }
      }
    }
  }
}
