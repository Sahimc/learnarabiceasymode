{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://word-tree.local/schema/word.schema.json",
  "title": "Word Tree word record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "position", "arabic"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "position": { "type": "integer", "minimum": 1 },
    "arabic": { "type": "string", "minLength": 1 },
    "teachingId": { "type": "string", "pattern": "^lesson:.+" },
    "transliteration": { "type": "string" },
    "gloss": { "type": "string" },
    "occurrenceRole": { "type": "string" },
    "sourceReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/providerReference" }
    },
    "breakdown": {
      "$ref": "#/$defs/wordBreakdown"
    },
    "breakdownOverride": {
      "$ref": "#/$defs/wordBreakdown",
      "description": "Occurrence-specific override resolved before a shared teaching-entry breakdown."
    },
    "morphology": {
      "$ref": "#/$defs/morphology",
      "description": "Provider-backed morphological evidence. This is separate from project-authored teaching prose."
    }
  },
  "$defs": {
    "wordBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "sourceText", "parts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["atomic", "segmented"] },
        "sourceText": { "type": "string", "minLength": 1 },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/breakdownPart" }
        }
      }
    },
    "breakdownPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "sourceText",
        "displayText",
        "label",
        "meaning",
        "kind"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "sourceText": { "type": "string", "minLength": 1 },
        "displayText": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "whole",
            "prefix",
            "stem",
            "suffix",
            "article",
            "preposition",
            "subject-marker",
            "object-pronoun",
            "possessive-pronoun",
            "ending",
            "connector",
            "other"
          ]
        }
      }
    },
    "providerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "recordKey"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "recordKey": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "attribution": { "type": "string" }
      }
    },
    "morphology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "recordKey",
        "version",
        "sourceText",
        "features"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "recordKey": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sourceText": { "type": "string", "minLength": 1 },
        "lemma": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "partOfSpeech": { "type": "string", "minLength": 1 },
        "features": {
          "type": "array",
          "items": { "$ref": "#/$defs/morphologyFeature" }
        },
        "segmentation": {
          "type": "array",
          "items": { "$ref": "#/$defs/morphologySurfacePart" }
        },
        "formation": {
          "type": "array",
          "items": { "$ref": "#/$defs/morphologyFormationPart" }
        }
      }
    },
    "morphologyFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "morphologySurfacePart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceText", "displayText", "label", "meaning", "kind"],
      "properties": {
        "sourceText": { "type": "string", "minLength": 1 },
        "displayText": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "whole",
            "prefix",
            "stem",
            "suffix",
            "article",
            "preposition",
            "subject-marker",
            "object-pronoun",
            "possessive-pronoun",
            "ending",
            "connector",
            "other"
          ]
        }
      }
    },
    "morphologyFormationPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayText", "label", "meaning", "kind"],
      "properties": {
        "displayText": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["lemma", "ending", "pattern", "other"] }
      }
    }
  }
}
