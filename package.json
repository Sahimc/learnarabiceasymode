{
  "name": "quranic-arabic-word-tree",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/content-mapping.test.mjs",
    "test:unit": "node --test tests",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check app content-import docs scripts db",
    "format:write": "prettier --write app content-import docs scripts db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:status": "tsx scripts/db-status.ts",
    "sources:status": "tsx scripts/source-status.ts",
    "sources:refresh": "tsx scripts/source-refresh.ts",
    "translations:import": "tsx scripts/import-translation.ts",
    "translations:status": "tsx scripts/translation-status.ts",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:status": "tsx scripts/content-status.ts",
    "content:coverage": "tsx scripts/content-coverage.ts",
    "content:scaffold": "tsx scripts/content-scaffold.ts",
    "content:import": "tsx scripts/content-import.ts",
    "pdf:ayah": "tsx scripts/generate-pdf.ts ayah",
    "pdf:surah": "tsx scripts/generate-pdf.ts surah",
    "pdf:volume": "tsx scripts/generate-pdf.ts volume",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pagedjs": "0.4.3",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/pg": "8.15.5",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "vitest": "3.2.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
